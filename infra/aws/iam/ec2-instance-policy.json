{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPullProjectRepositoryOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:__AWS_REGION__:__AWS_ACCOUNT_ID__:repository/taskplatform"
    },
    {
      "Sid": "ReadProjectSecretsOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameters",
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:__AWS_REGION__:__AWS_ACCOUNT_ID__:parameter/taskplatform/prod",
        "arn:aws:ssm:__AWS_REGION__:__AWS_ACCOUNT_ID__:parameter/taskplatform/prod/*"
      ]
    }
  ]
}
