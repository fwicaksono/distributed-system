# =====================================================================================
# Local development environment. Copy to `.env` and change every value marked CHANGE_ME.
#   cp .env.example .env
# `.env` is git-ignored. On AWS these values come from SSM Parameter Store instead
# (see deploy/scripts/render-env.sh) — never commit real secrets.
# =====================================================================================

# --- Application ---------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_64_character_secret_value_here_000000
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated list of browser origins allowed to call the API (empty = CORS disabled)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (also read by the postgres container itself) --------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=taskplatform
POSTGRES_USER=taskplatform
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Redis ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
CACHE_TASK_TTL_SECONDS=60

# --- Rate limiting -------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Generous locally so load tests measure the system, not the limiter.
RATE_LIMIT_REQUESTS=100000
RATE_LIMIT_WINDOW_SECONDS=60

# --- RabbitMQ ------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=taskplatform
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# --- Worker --------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_PROCESSING_LEASE_SECONDS=60
WORKER_CPU_POOL_SIZE=2

# --- Grafana -------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# --- Uvicorn: trust X-Forwarded-For only from these proxies ---------------------------
# Locally Nginx sits on a Docker network; "*" is acceptable ONLY because the API port is
# not published to the host. On EC2 set the edge node's private IP.
FORWARDED_ALLOW_IPS=*
