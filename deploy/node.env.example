# /opt/taskplatform/shared/node.env — NON-SECRET, per-host configuration.
# Created once per EC2 instance (bootstrap-host.sh copies it into place). Secrets are NOT
# here: they are rendered from SSM Parameter Store into separate 0600 files at deploy time.
#
# CHANGE: ROLE, PRIVATE_IP per host; AWS_REGION, ECR_REGISTRY, DOMAIN for your account.
# No inline comments after values: systemd's EnvironmentFile would keep them as part of the value.

# edge | app | broker | ops | data
ROLE=app
# this instance's fixed private IP
PRIVATE_IP=10.20.11.20

# CHANGE: your region
AWS_REGION=ap-southeast-1
# CHANGE: <account>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
ECR_REPOSITORY=taskplatform
SSM_PARAMETER_PATH=/taskplatform/prod

# CHANGE: your domain (used by the edge node)
DOMAIN=api.example.com
# edge only: edge-http until the certificate exists, then edge-https
NGINX_SITE_TEMPLATE=edge-http

VPC_CIDR=10.20.0.0/16
EDGE_IP=10.20.1.10
APP_IP=10.20.11.20
BROKER_IP=10.20.11.30
OPS_IP=10.20.11.40
DATA_IP=10.20.11.50
